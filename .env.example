# Adonis Environment Configuration Template
# Copy this file to .env for local Docker Compose or standalone running.
# NEVER commit the actual .env file to version control.

# Required in production: 256-bit secret key for HMAC-SHA256 (minimum 32 characters / 64 hex characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# MongoDB Connection URI
# Local development: mongodb://localhost:27017/adonis
# Docker Compose: mongodb://mongodb:27017/adonis
MONGODB_URI=mongodb://localhost:27017/adonis

# Server Port
SERVER_PORT=8080
