# ==============================================================================
# Adonis Production Environment Configuration Template (Phase 12)
# ==============================================================================
# Copy this file to .env for Docker Compose production or standalone deployment.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 2. SECURITY
# ------------------------------------------------------------------------------
# 256-bit secret key for JWT HMAC-SHA256 (minimum 32 characters / 64 hex characters)
# REQUIRED IN PRODUCTION: The production container stack will fail fast if JWT_SECRET is unset.
# Generate via: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. MONGODB
# ------------------------------------------------------------------------------
# Internal Docker network (unauthenticated dev default): mongodb://mongodb:27017/adonis
# Standalone local dev: mongodb://localhost:27017/adonis
# Production authenticated URI:
#   mongodb://adonis_admin:replace-with-secure-password@mongodb:27017/adonis?authSource=admin
# When MONGODB_USERNAME & MONGODB_PASSWORD are provided, Docker Compose enables
# MongoDB authentication and provisions MONGO_INITDB_ROOT_USERNAME/PASSWORD.
MONGODB_URI=mongodb://mongodb:27017/adonis
MONGO_INITDB_DATABASE=adonis
MONGODB_USERNAME=
MONGODB_PASSWORD=replace-with-secure-password

# ------------------------------------------------------------------------------
# 4. REDIS
# ------------------------------------------------------------------------------
# Internal Docker network: redis:6379
# Standalone local dev: localhost:6379
# In production, when REDIS_PASSWORD is provided, Redis requires authentication
# via --requirepass, the container healthcheck uses -a, and Spring Boot authenticates.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-secure-password
REDIS_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 5. WORKER
# ------------------------------------------------------------------------------
# Redis Streams asynchronous queue and distributed worker lease settings
REDIS_STREAM_NAME=adonis:execution:stream
REDIS_CONSUMER_GROUP=adonis-workers
REDIS_CONSUMER_NAME=
WORKER_ENABLED=true
WORKER_POLL_TIMEOUT_MS=2000
WORKER_PENDING_CLAIM_IDLE_MS=60000
WORKER_LEASE_DURATION_MS=60000
WORKER_HEARTBEAT_INTERVAL_MS=20000

# ------------------------------------------------------------------------------
# 6. SCHEDULER
# ------------------------------------------------------------------------------
# Workflow trigger scheduling engine settings
SCHEDULER_ENABLED=true
SCHEDULER_POLLING_INTERVAL_MS=10000

# ------------------------------------------------------------------------------
# 7. WEBHOOK
# ------------------------------------------------------------------------------
# Inbound webhook ingestion limits (default: 1MB = 1048576 bytes)
WEBHOOK_MAX_BODY_SIZE_BYTES=1048576

# ------------------------------------------------------------------------------
# 8. AI
# ------------------------------------------------------------------------------
# Optional AI provider credentials. Never commit keys to version control.
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_CONNECT_TIMEOUT_MS=10000
AI_READ_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 9. CORS
# ------------------------------------------------------------------------------
# Allowed origins for browser API access (comma-separated, e.g. https://app.adonis.io)
# In production, empty string permits same-origin requests via Nginx reverse proxy.
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 10. LOGGING
# ------------------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ADONIS=INFO

# ------------------------------------------------------------------------------
# 11. DEPLOYMENT
# ------------------------------------------------------------------------------
# Deterministic image identifiers, release version, and Git build metadata
BACKEND_IMAGE=adonis-backend:latest
FRONTEND_IMAGE=adonis-frontend:latest
GIT_COMMIT=unknown
APP_VERSION=0.0.1-SNAPSHOT
