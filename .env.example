# ==============================================================================
# Adonis Environment Configuration Template
# ==============================================================================
# Copy this file to .env for Docker Compose production or standalone deployment.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FRONTEND_PORT=80

# Security: 256-bit secret key for JWT HMAC-SHA256 (minimum 32 characters / 64 hex characters)
# REQUIRED IN PRODUCTION: The production container stack will fail fast if JWT_SECRET is unset.
# Generate via: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# MongoDB Connection (Phase 1)
# Container network: mongodb://mongodb:27017/adonis
# Standalone local dev: mongodb://localhost:27017/adonis
MONGODB_URI=mongodb://mongodb:27017/adonis
MONGO_INITDB_DATABASE=adonis

# Redis Connection (Phase 7 & 7.1)
# Container network: redis:6379
# Standalone local dev: localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Asynchronous Queue & Worker Configuration (Phase 7.1 & 7.1.1)
REDIS_STREAM_NAME=adonis:execution:stream
REDIS_CONSUMER_GROUP=adonis-workers
REDIS_CONSUMER_NAME=
WORKER_ENABLED=true
WORKER_POLL_TIMEOUT_MS=2000
WORKER_PENDING_CLAIM_IDLE_MS=60000
WORKER_LEASE_DURATION_MS=60000
WORKER_HEARTBEAT_INTERVAL_MS=20000

# Scheduler Configuration (Phase 8)
SCHEDULER_ENABLED=true
SCHEDULER_POLLING_INTERVAL_MS=10000

# Webhook Configuration (Phase 8.1)
WEBHOOK_MAX_BODY_SIZE_BYTES=1048576

# AI Provider Configuration (Phase 9)
# Provide API keys for the providers you wish to enable. Never commit keys to version control.
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_CONNECT_TIMEOUT_MS=10000
AI_READ_TIMEOUT_MS=60000

# Optional: Custom CORS allowed origins (comma-separated, e.g. https://adonis.example.com)
CORS_ALLOWED_ORIGINS=
